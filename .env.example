# Model (required to reply)
DEEPSEEK_API_KEY=
# Optional: override agent.yaml's model id for this station.
# MODEL=deepseek-v4-pro

# Optional temporary additions to the ordered plugin list in station.yaml.
# ZING_PLUGINS=./plugins/tools/my_private_tool
# ZING_STATION=./station.yaml
# Optional: legacy (default) or durable. Overrides runtime in station.yaml.
# ZING_RUNTIME=durable

# Web search (required the first time the model searches)
BRAVE_API_KEY=

# Telegram (required for the long-running station)
TELEGRAM_BOT_TOKEN=
# Your numeric user id. Lock the bot to you. Find it via @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Optional. Same ids as TELEGRAM_ALLOWED_USER_IDS.
# The enabled Notes plugin uses these ids to trust passive memory extraction.
ZING_MEMORY_OWNER_IDS=

# Optional external MCP tools. Enable ./plugins/tools/mcp in station.yaml first.
# The plugin pins MCP 2026-07-28.
MCP_URL=
MCP_SERVER_ALIAS=market
MCP_BEARER_TOKEN=
# JSON map from remote tool name to a safe local suffix, for example:
# MCP_TOOL_ALIASES={"get-stock-quote":"quote"}
MCP_TOOL_ALIASES=
# Leave empty for 2026-07-28. Set 2025-11-25 only for explicit compatibility.
MCP_PROTOCOL_VERSION=
