<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zing.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/NODE</string>
    <string>/ABSOLUTE/PATH/TO/ZING/node_modules/tsx/dist/cli.mjs</string>
    <string>src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/ZING</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ZING_HOME</key>
    <string>/ABSOLUTE/PATH/TO/PERSISTENT/ZING_HOME</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ExitTimeOut</key>
  <integer>65</integer>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/ZING/zing.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/ZING/zing.stderr.log</string>
</dict>
</plist>
